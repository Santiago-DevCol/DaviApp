# Copy to backend/.env (git-ignored). Values match docker-compose.yml.
DATABASE_URL=postgres://app:app@localhost:5432/techdocs
PORT=3000
NODE_ENV=development
MAX_FILE_SIZE_BYTES=10485760
STORAGE_DIR=./storage
CORS_ORIGIN=http://localhost:5173

# If host port 5432 is already taken, start Postgres with
# `POSTGRES_PORT=5433 docker compose up -d postgres` and adjust DATABASE_URL.
